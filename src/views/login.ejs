<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login — Photobinc Admin & Operator</title>
  <style>
    * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body {
      margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
      background-color: #f4f4f0;
      background-image: radial-gradient(#cbd5e1 1.5px, transparent 1.5px);
      background-size: 24px 24px; padding: 20px;
    }
    .card {
      width: 100%; max-width: 400px; background: #fff; border: 3px solid #111;
      border-radius: 16px; box-shadow: 8px 8px 0 #111; padding: 30px 26px;
    }
    .badge {
      display: inline-block; background: #facc15; border: 2px solid #111; border-radius: 8px;
      padding: 4px 10px; font-size: 11px; font-weight: 900; margin-bottom: 12px;
    }
    h1 { margin: 0 0 6px; font-size: 24px; color: #0f172a; }
    p.sub { margin: 0 0 22px; font-size: 13px; color: #64748b; }
    label { display: block; font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 6px; }
    input {
      width: 100%; padding: 11px 14px; border: 2px solid #111; border-radius: 10px;
      font-size: 14px; margin-bottom: 16px; outline: none; background: #f8fafc;
    }
    input:focus { background: #fff; border-color: #2563eb; }
    button {
      width: 100%; padding: 13px; background: #4ade80; color: #111; border: 3px solid #111;
      box-shadow: 4px 4px 0 #111; border-radius: 10px; font-size: 15px; font-weight: 900;
      cursor: pointer; text-transform: uppercase;
    }
    button:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 #111; }
    .err {
      background: #fee2e2; border: 2px solid #ef4444; color: #b91c1c; padding: 10px 12px;
      border-radius: 8px; font-size: 13px; font-weight: 700; margin-bottom: 16px;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="badge">PHOTOBINC CONTROL PANEL</div>
    <h1>Masuk Dashboard</h1>
    <p class="sub">Gunakan akun Admin atau Operator untuk melanjutkan.</p>
    <% if (error) { %>
      <div class="err"><%= error %></div>
    <% } %>
    <form method="POST" action="/login">
      <input type="hidden" name="next" value="<%= nextUrl %>" />
      <label>Username</label>
      <input type="text" name="username" required autofocus placeholder="admin / operator" />
      <label>Password</label>
      <input type="password" name="password" required placeholder="••••••••" />
      <button type="submit">Masuk Sekarang</button>
    </form>
  </div>
</body>
</html>