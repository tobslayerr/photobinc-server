<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Galeri Foto — Photobinc</title>
  <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet" />
  <script src="https://rawcdn.githack.com/buzzfeed/libgif-js/master/libgif.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Space+Mono:wght@700&display=swap');

    :root {
      --bg-base: #090d16;
      --surface: rgba(17, 24, 39, 0.82);
      --surface-solid: #111827;
      --surface-soft: rgba(255, 255, 255, 0.06);
      --border: rgba(255, 255, 255, 0.11);
      --border-strong: rgba(255, 255, 255, 0.18);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --pink: #ff99c8;
      --blue: #90dbf4;
      --mint: #d0f4de;
      --green: #4ade80;
      --yellow: #facc15;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100dvh;
      background-color: var(--bg-base);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* Ambient Studio Background */
    .bg-ambient {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
    }
    .bg-ambient::before {
      content: '';
      position: absolute;
      width: 340px;
      height: 340px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 153, 200, 0.22) 0%, transparent 70%);
      top: -110px;
      left: -100px;
    }
    .bg-ambient::after {
      content: '';
      position: absolute;
      width: 360px;
      height: 360px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(144, 219, 244, 0.18) 0%, transparent 70%);
      bottom: -120px;
      right: -110px;
    }

    /* Empty / Loading State */
    .center-wrap {
      position: relative;
      z-index: 2;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .state-card {
      background: var(--surface);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid var(--border-strong);
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
      border-radius: 26px;
      padding: 36px 26px;
      max-width: 380px;
      width: 100%;
      text-align: center;
    }
    .state-icon {
      width: 72px;
      height: 72px;
      margin: 0 auto 18px;
      border-radius: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 34px;
      color: #0f172a;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
    }
    .state-card h2 {
      margin: 0 0 8px;
      font-size: 21px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #fff;
    }
    .state-card p {
      margin: 0;
      font-size: 13.5px;
      line-height: 1.55;
      color: var(--text-muted);
      font-weight: 500;
    }

    /* Main Shell */
    #pb-neo-app {
      position: relative;
      z-index: 2;
      min-height: 100dvh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: max(12px, env(safe-area-inset-top)) 14px max(22px, env(safe-area-inset-bottom)) 14px;
    }
    .neo-shell {
      width: 100%;
      max-width: 460px;
      display: flex;
      flex-direction: column;
      gap: 11px;
    }

    /* Top Brand Bar */
    .neo-topbar {
      background: var(--surface);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 10px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
    }
    .neo-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }
    .neo-avatar {
      width: 42px;
      height: 42px;
      border-radius: 13px;
      border: 1.5px solid rgba(255, 153, 200, 0.55);
      object-fit: cover;
      flex-shrink: 0;
      background: #1e293b;
    }
    .neo-brand-info {
      min-width: 0;
    }
    .neo-brand-title {
      font-size: 14.5px;
      font-weight: 800;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 7px;
      letter-spacing: 0.02em;
    }
    .neo-count-pill {
      background: rgba(255, 153, 200, 0.18);
      color: var(--pink);
      border: 1px solid rgba(255, 153, 200, 0.4);
      font-family: 'Space Mono', monospace;
      font-size: 9.5px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 99px;
      white-space: nowrap;
    }
    .neo-brand-sub {
      font-size: 11.5px;
      font-weight: 600;
      color: var(--text-muted);
      margin-top: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .neo-brand-sub a {
      color: var(--blue);
      text-decoration: none;
      font-weight: 700;
    }

    .neo-top-actions {
      display: flex;
      gap: 6px;
      flex-shrink: 0;
    }
    .neo-mini-btn {
      border: 1px solid var(--border-strong);
      border-radius: 11px;
      padding: 8px 11px;
      font-size: 11px;
      font-weight: 800;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: transform 0.14s ease, opacity 0.14s ease, background 0.2s ease;
    }
    .neo-mini-btn:active {
      transform: scale(0.95);
    }
    .neo-btn-yellow {
      background: rgba(250, 204, 21, 0.15);
      border-color: rgba(250, 204, 21, 0.45);
      color: #fde047;
    }
    .neo-btn-white {
      background: rgba(255, 255, 255, 0.08);
      color: #f8fafc;
    }

    /* AR Banner */
    .neo-ar-banner {
      background: linear-gradient(135deg, rgba(74, 222, 128, 0.18) 0%, rgba(56, 189, 248, 0.16) 100%);
      border: 1px solid rgba(74, 222, 128, 0.45);
      border-radius: 16px;
      padding: 10px 13px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      text-decoration: none;
      color: #fff;
      transition: transform 0.15s ease;
    }
    .neo-ar-banner:active {
      transform: scale(0.98);
    }
    .neo-ar-left {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }
    .neo-ar-icon {
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, #4ade80, #22c55e);
      color: #052e16;
      border-radius: 11px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 19px;
      flex-shrink: 0;
    }
    .neo-ar-text strong {
      display: block;
      font-size: 12.5px;
      font-weight: 800;
      line-height: 1.2;
      color: #ecfdf5;
    }
    .neo-ar-text span {
      display: block;
      font-size: 11px;
      font-weight: 500;
      color: #cbd5e1;
      line-height: 1.3;
      margin-top: 2px;
    }
    .neo-ar-go {
      background: #4ade80;
      color: #052e16;
      font-family: 'Space Mono', monospace;
      font-size: 10.5px;
      font-weight: 700;
      padding: 6px 10px;
      border-radius: 9px;
      display: inline-flex;
      align-items: center;
      gap: 3px;
      flex-shrink: 0;
    }

    /* Sync Banner */
    .neo-sync-banner {
      background: rgba(250, 204, 21, 0.12);
      border: 1px dashed rgba(250, 204, 21, 0.5);
      border-radius: 12px;
      padding: 8px 12px;
      font-size: 11.5px;
      font-weight: 700;
      color: #fde047;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
    }

    /* Category Tabs */
    .neo-tabs-wrap {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .neo-tab-hint {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      padding: 0 4px;
    }
    .neo-tab-hint strong {
      color: var(--blue);
    }
    .neo-tabs {
      display: flex;
      gap: 7px;
      overflow-x: auto;
      padding: 2px 1px;
      scrollbar-width: none;
    }
    .neo-tabs::-webkit-scrollbar {
      display: none;
    }
    .neo-tab {
      flex: 1 0 auto;
      background: rgba(255, 255, 255, 0.06);
      color: #cbd5e1;
      border: 1px solid var(--border);
      border-radius: 13px;
      padding: 9px 12px;
      font-size: 11.5px;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.18s ease;
      font-family: inherit;
    }
    .neo-tab.is-active {
      color: #090d16;
      border-color: transparent;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28);
    }
    .neo-tab-badge {
      background: rgba(255, 255, 255, 0.14);
      color: #fff;
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      padding: 1px 6px;
      border-radius: 99px;
    }
    .neo-tab.is-active .neo-tab-badge {
      background: rgba(9, 13, 22, 0.18);
      color: #090d16;
    }

    /* Main Stage Card */
    .neo-stage-card {
      background: var(--surface);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid var(--border-strong);
      border-radius: 22px;
      padding: 13px;
      display: flex;
      flex-direction: column;
      gap: 11px;
      box-shadow: 0 20px 44px rgba(0, 0, 0, 0.4);
    }
    .neo-stage-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .neo-stage-badge {
      background: var(--pink);
      color: #090d16;
      border-radius: 99px;
      padding: 5px 12px;
      font-family: 'Space Mono', monospace;
      font-size: 10.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .neo-stage-right {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .neo-stage-counter {
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      font-weight: 700;
      color: #e2e8f0;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid var(--border);
      border-radius: 99px;
      padding: 4px 10px;
    }
    .neo-icon-sq {
      width: 34px;
      height: 34px;
      background: rgba(255, 255, 255, 0.08);
      color: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      cursor: pointer;
      transition: transform 0.14s ease, background 0.18s ease;
    }
    .neo-icon-sq:active {
      transform: scale(0.92);
    }
    .neo-icon-sq.is-liked {
      background: rgba(244, 63, 94, 0.22);
      border-color: rgba(244, 63, 94, 0.55);
      color: #fb7185;
    }

    /* Viewport */
    .neo-viewport {
      position: relative;
      width: 100%;
      height: clamp(270px, 45dvh, 430px);
      background-color: #05070d;
      background-image:
        radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
      background-size: 16px 16px;
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .neo-media-slot {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 10px;
      cursor: zoom-in;
    }
    .neo-media-slot img,
    .neo-media-slot video {
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: 10px;
      display: block;
    }
    .neo-nav-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 36px;
      height: 36px;
      background: rgba(15, 23, 42, 0.78);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 50%;
      font-size: 20px;
      display: none;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 5;
      transition: transform 0.14s ease, background 0.15s ease;
    }
    .neo-nav-arrow:active {
      transform: translateY(-50%) scale(0.92);
    }
    .neo-prev { left: 10px; }
    .neo-next { right: 10px; }

    /* Thumb Strip */
    .neo-thumb-strip {
      display: none;
      gap: 8px;
      overflow-x: auto;
      padding: 2px 1px;
      scrollbar-width: none;
    }
    .neo-thumb-strip::-webkit-scrollbar {
      display: none;
    }
    .neo-thumb-item {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      gap: 7px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      border-radius: 11px;
      padding: 4px 10px 4px 4px;
      cursor: pointer;
      font-size: 11px;
      font-weight: 700;
      color: #cbd5e1;
      font-family: inherit;
      transition: all 0.16s ease;
    }
    .neo-thumb-item.is-selected {
      background: rgba(144, 219, 244, 0.2);
      border-color: var(--blue);
      color: #fff;
    }
    .neo-thumb-preview {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      object-fit: cover;
      background: #0f172a;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--pink);
      font-size: 14px;
    }

    /* Caption Bar */
    .neo-caption-bar {
      background: rgba(255, 255, 255, 0.045);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 9px 12px;
      font-size: 12px;
      font-weight: 500;
      color: #cbd5e1;
      line-height: 1.45;
    }
    .neo-caption-bar strong {
      color: #fff;
      font-weight: 800;
      margin-right: 4px;
    }

    /* Action Buttons */
    .neo-action-grid {
      display: grid;
      grid-template-columns: 1.35fr 1fr 1fr;
      gap: 8px;
    }
    .neo-act-btn {
      border: none;
      border-radius: 13px;
      padding: 12px 8px;
      font-size: 11.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      white-space: nowrap;
      font-family: inherit;
      transition: transform 0.14s ease, opacity 0.15s ease;
    }
    .neo-act-btn:active {
      transform: scale(0.96);
    }
    .neo-act-dl {
      background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%);
      color: #052e16;
      box-shadow: 0 8px 20px rgba(34, 197, 94, 0.3);
    }
    .neo-act-black {
      background: linear-gradient(135deg, #facc15 0%, #eab308 100%);
      color: #1c1917;
    }
    .neo-act-ig {
      background: linear-gradient(135deg, #f472b6 0%, #ec4899 100%);
      color: #fff;
    }
    .neo-act-tt {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid var(--border-strong);
      color: #f8fafc;
    }

    /* Footer */
    .neo-footer-note {
      text-align: center;
      font-size: 11.5px;
      font-weight: 600;
      color: var(--text-muted);
      padding: 4px 0 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
    }
    .neo-footer-note strong {
      color: var(--pink);
    }

    /* Lightbox */
    .neo-lightbox {
      position: fixed;
      inset: 0;
      z-index: 99999;
      background: rgba(5, 7, 13, 0.94);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 18px;
    }
    .neo-lb-close {
      position: fixed;
      top: max(16px, env(safe-area-inset-top));
      right: 16px;
      background: rgba(255, 255, 255, 0.14);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 99px;
      padding: 8px 15px;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-family: inherit;
    }
    .neo-lb-content {
      width: 100%;
      max-width: 94vw;
      max-height: 82dvh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .neo-lb-content img,
    .neo-lb-content video {
      max-width: 100%;
      max-height: 82dvh;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.65);
      object-fit: contain;
    }

    .spin-anim {
      animation: spin 1s linear infinite;
      display: inline-block;
    }
    @keyframes spin {
      100% { transform: rotate(360deg); }
    }

    @media (max-width: 380px) {
      .neo-action-grid {
        grid-template-columns: 1fr 1fr;
      }
      .neo-act-dl {
        grid-column: span 2;
      }
      .neo-mini-btn span {
        display: none;
      }
    }
  </style>
</head>
<body>
  <div class="bg-ambient" aria-hidden="true"></div>

  <% if (totalPosts === 0) { %>
    <div class="center-wrap">
      <% if (oid) { %>
        <div class="state-card">
          <div class="state-icon" style="background: linear-gradient(135deg, #facc15, #fb923c);">
            <i class="ri-loader-4-line spin-anim"></i>
          </div>
          <h2>Merakit Galeri...</h2>
          <p>Mesin sedang mengunggah Foto &amp; Live Video kamu.<br />Halaman akan otomatis terbuka dalam beberapa detik.</p>
        </div>
        <script>setTimeout(() => location.reload(), 3000);</script>
      <% } else { %>
        <div class="state-card">
          <div class="state-icon" style="background: linear-gradient(135deg, #fb7185, #ef4444); color: #fff;">
            <i class="ri-error-warning-fill"></i>
          </div>
          <h2>Galeri Tidak Tersedia</h2>
          <p>Tautan tidak valid atau masa berlaku galeri telah habis.</p>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div id="pb-neo-app" data-total-posts="<%= totalPosts %>">
      <div class="neo-shell">

        <!-- TOP BRAND BAR -->
        <div class="neo-topbar">
          <div class="neo-brand">
            <img src="<%= profileImg %>" alt="Photobinc" class="neo-avatar" />
            <div class="neo-brand-info">
              <div class="neo-brand-title">
                PHOTOBINC
                <span class="neo-count-pill"><%= totalPosts %> FILE</span>
              </div>
              <div class="neo-brand-sub">
                Digital Gallery &bull; <a href="https://www.instagram.com/photobinc" target="_blank" rel="noopener">@photobinc</a>
              </div>
            </div>
          </div>
          <div class="neo-top-actions">
            <button type="button" id="btn-copy-link" class="neo-mini-btn neo-btn-yellow" title="Salin Link Galeri">
              <i class="ri-links-line"></i> <span>SALIN</span>
            </button>
            <a href="https://www.instagram.com/photobinc" target="_blank" rel="noopener" class="neo-mini-btn neo-btn-white" title="Instagram Photobinc">
              <i class="ri-instagram-line"></i> <span>IG</span>
            </a>
          </div>
        </div>

        <!-- LIVE PHOTO AR BANNER -->
        <% if (liveArUrl) { %>
          <a href="<%= liveArUrl %>" class="neo-ar-banner">
            <div class="neo-ar-left">
              <span class="neo-ar-icon"><i class="ri-camera-lens-fill"></i></span>
              <div class="neo-ar-text">
                <strong>SCAN LIVE PHOTO AR</strong>
                <span>Arahkan kamera ke hasil cetak fisikmu agar bergerak!</span>
              </div>
            </div>
            <span class="neo-ar-go">BUKA <i class="ri-arrow-right-line"></i></span>
          </a>
        <% } %>

        <!-- SYNC PROGRESS BANNER -->
        <% if (!isUploadComplete) { %>
          <div class="neo-sync-banner">
            <i class="ri-loader-4-line spin-anim"></i>
            <span>Sedang mengunggah sisa fotomu... (Auto-refresh)</span>
          </div>
          <script>
            setInterval(async function() {
              try {
                const res = await fetch(window.location.href);
                const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
                const newApp = doc.getElementById('pb-neo-app');
                const curApp = document.getElementById('pb-neo-app');
                if (newApp && curApp && parseInt(newApp.dataset.totalPosts || '0', 10) > parseInt(curApp.dataset.totalPosts || '0', 10)) {
                  location.reload();
                }
              } catch (e) {}
            }, 4000);
          </script>
        <% } %>

        <!-- CATEGORY TABS -->
        <div class="neo-tabs-wrap">
          <div class="neo-tab-hint" id="neo-tab-hint" style="display:none;">
            <i class="ri-sparkling-2-fill" style="color: var(--blue);"></i>
            <span>Pilih tab di bawah untuk lihat <strong>Frame, Live Video, GIF &amp; Pose HD</strong></span>
          </div>
          <div class="neo-tabs" id="neo-tabs">
            <% availableCats.forEach(function(cat, idx) { %>
              <button type="button" class="neo-tab <%= idx === 0 ? 'is-active' : '' %>" data-cat="<%= cat.key %>" data-color="<%= cat.color %>">
                <i class="<%= cat.icon %>"></i>
                <span><%= cat.label %></span>
                <span class="neo-tab-badge"><%= cat.count %></span>
              </button>
            <% }) %>
          </div>
        </div>

        <!-- MAIN STAGE CARD -->
        <div class="neo-stage-card">
          <div class="neo-stage-head">
            <div class="neo-stage-badge" id="stage-badge">LOADING...</div>
            <div class="neo-stage-right">
              <span class="neo-stage-counter" id="stage-counter">1 / 1</span>
              <button type="button" id="btn-like" class="neo-icon-sq" aria-label="Suka"><i class="ri-heart-3-line"></i></button>
              <button type="button" id="btn-zoom" class="neo-icon-sq" aria-label="Perbesar"><i class="ri-fullscreen-line"></i></button>
            </div>
          </div>

          <div class="neo-viewport" id="stage-viewport">
            <button type="button" id="btn-prev" class="neo-nav-arrow neo-prev" aria-label="Sebelumnya"><i class="ri-arrow-left-s-line"></i></button>
            <div class="neo-media-slot" id="stage-media-slot"></div>
            <button type="button" id="btn-next" class="neo-nav-arrow neo-next" aria-label="Berikutnya"><i class="ri-arrow-right-s-line"></i></button>
          </div>

          <div class="neo-thumb-strip" id="neo-thumb-strip"></div>
          <div class="neo-caption-bar" id="stage-caption"></div>

          <div class="neo-action-grid">
            <button type="button" id="btn-act-dl" class="neo-act-btn neo-act-dl"><i class="ri-download-2-fill"></i> UNDUH HD</button>
            <button type="button" id="btn-act-mp4" class="neo-act-btn neo-act-black" style="display:none;"><i class="ri-video-download-fill"></i> VIDEO IG</button>
            <button type="button" id="btn-act-ig" class="neo-act-btn neo-act-ig"><i class="ri-instagram-line"></i> IG STORY</button>
            <button type="button" id="btn-act-tt" class="neo-act-btn neo-act-tt"><i class="ri-share-forward-fill"></i> SHARE</button>
          </div>
        </div>

        <!-- FOOTER -->
        <div class="neo-footer-note">
          <i class="ri-verified-badge-fill" style="color: #4ade80;"></i>
          <span>#Photobinc &bull; Tag <strong>@photobinc</strong> di Story kamu!</span>
        </div>
      </div>
    </div>

    <!-- FULLSCREEN LIGHTBOX -->
    <div id="neo-lightbox" class="neo-lightbox">
      <button type="button" id="btn-close-lb" class="neo-lb-close"><i class="ri-close-line"></i> TUTUP</button>
      <div id="neo-lb-content" class="neo-lb-content"></div>
    </div>

    <script>
      (function() {
        const RAW_PB_ITEMS = <%- JSON.stringify(mediaItems).replace(/</g, '\\u003c') %>;
        const SERVER_CATS  = <%- JSON.stringify(availableCats).replace(/</g, '\\u003c') %>;

        // Pengaman otomatis: jika ada file pose HD (final_raw_ / raw- / type raw)
        // yang sempat masuk kategori 'frame' dari upload mode Vercel, pisahkan ke kategori 'raw'
        let rawCounter = 0;
        const PB_ITEMS = RAW_PB_ITEMS.map((item) => {
          const clone = { ...item };
          const checkStr = [clone.alias_name, clone.url, clone.filename, clone.id].filter(Boolean).join(' ').toLowerCase();
          const isRawLike =
            clone.cat === 'raw' ||
            clone.type === 'raw' ||
            /(^|[\/_\-])final_raw_|(^|[\/_\-])raw[\-_]/i.test(checkStr);

          if (isRawLike && clone.type !== 'video' && clone.type !== 'gif') {
            rawCounter++;
            if (clone.cat !== 'raw') {
              clone.cat = 'raw';
              clone.badge = 'POSE HD #' + rawCounter;
              clone.accent = '#90dbf4';
              clone.thumbLabel = 'Pose #' + rawCounter;
              clone.caption = 'Foto Pose HD satuan #' + rawCounter + ' siap diunduh resolusi penuh!';
            }
          }
          return clone;
        });

        const CAT_META = {
          frame: { label: 'Frame',      icon: 'ri-image-2-fill',  color: '#ff99c8' },
          video: { label: 'Live Video', icon: 'ri-movie-2-fill',  color: '#facc15' },
          gif:   { label: 'GIF',        icon: 'ri-file-gif-fill', color: '#d0f4de' },
          raw:   { label: 'Pose HD',    icon: 'ri-camera-3-fill', color: '#90dbf4' },
        };
        SERVER_CATS.forEach((c) => {
          if (c && c.key) {
            CAT_META[c.key] = {
              label: c.label || (CAT_META[c.key] && CAT_META[c.key].label) || c.key,
              icon:  c.icon  || (CAT_META[c.key] && CAT_META[c.key].icon)  || 'ri-image-line',
              color: (CAT_META[c.key] && CAT_META[c.key].color) || c.color || '#90dbf4',
            };
          }
        });

        const CAT_ORDER = ['frame', 'video', 'gif', 'raw'];
        const countByCat = {};
        PB_ITEMS.forEach((it) => {
          countByCat[it.cat] = (countByCat[it.cat] || 0) + 1;
        });
        const allCatKeys = [
          ...CAT_ORDER.filter((k) => countByCat[k] > 0),
          ...Object.keys(countByCat).filter((k) => !CAT_ORDER.includes(k) && countByCat[k] > 0),
        ];

        const likedSet   = new Set();
        const tabsWrap   = document.getElementById('neo-tabs');
        const tabHint    = document.getElementById('neo-tab-hint');
        const stageBadge = document.getElementById('stage-badge');
        const stageCount = document.getElementById('stage-counter');
        const viewport   = document.getElementById('stage-viewport');
        const mediaSlot  = document.getElementById('stage-media-slot');
        const thumbStrip = document.getElementById('neo-thumb-strip');
        const captionBar = document.getElementById('stage-caption');
        const btnPrev    = document.getElementById('btn-prev');
        const btnNext    = document.getElementById('btn-next');
        const btnLike    = document.getElementById('btn-like');
        const btnZoom    = document.getElementById('btn-zoom');
        const btnActDl   = document.getElementById('btn-act-dl');
        const btnActMp4  = document.getElementById('btn-act-mp4');
        const btnActIg   = document.getElementById('btn-act-ig');
        const btnActTt   = document.getElementById('btn-act-tt');
        const lightbox   = document.getElementById('neo-lightbox');
        const lbContent  = document.getElementById('neo-lb-content');
        const btnCloseLb = document.getElementById('btn-close-lb');

        // Render ulang tab kategori sesuai hasil normalisasi
        if (allCatKeys.length > 0) {
          tabsWrap.innerHTML = '';
          allCatKeys.forEach((key, idx) => {
            const meta = CAT_META[key] || { label: key.toUpperCase(), icon: 'ri-image-line', color: '#90dbf4' };
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'neo-tab' + (idx === 0 ? ' is-active' : '');
            btn.dataset.cat = key;
            btn.dataset.color = meta.color;
            btn.innerHTML =
              '<i class="' + meta.icon + '"></i>' +
              '<span>' + meta.label + '</span>' +
              '<span class="neo-tab-badge">' + countByCat[key] + '</span>';
            btn.addEventListener('click', () => selectCategory(key));
            tabsWrap.appendChild(btn);
          });
          if (tabHint) tabHint.style.display = allCatKeys.length > 1 ? 'flex' : 'none';
        }

        let activeCat = allCatKeys[0] || (PB_ITEMS.length > 0 ? PB_ITEMS[0].cat : 'frame');
        let filtered  = [];
        let activeIdx = 0;

        const getCurrentItem = () => filtered[activeIdx] || null;

        function renderThumbStrip() {
          if (filtered.length <= 1) {
            thumbStrip.style.display = 'none';
            thumbStrip.innerHTML = '';
            return;
          }
          thumbStrip.style.display = 'flex';
          thumbStrip.innerHTML = '';
          filtered.forEach((item, idx) => {
            const chip = document.createElement('button');
            chip.type = 'button';
            chip.className = 'neo-thumb-item' + (idx === activeIdx ? ' is-selected' : '');
            if (item.type === 'video') {
              chip.innerHTML = '<span class="neo-thumb-preview"><i class="ri-play-fill"></i></span><span>' + item.thumbLabel + '</span>';
            } else {
              const thumbImg = document.createElement('img');
              thumbImg.src = item.previewUrl || item.url;
              thumbImg.className = 'neo-thumb-preview';
              thumbImg.alt = '';
              thumbImg.onerror = function() {
                if (this.src !== item.url) this.src = item.url;
              };
              const lbl = document.createElement('span');
              lbl.textContent = item.thumbLabel;
              chip.appendChild(thumbImg);
              chip.appendChild(lbl);
            }
            chip.addEventListener('click', () => { activeIdx = idx; renderStage(); });
            thumbStrip.appendChild(chip);
          });
        }

        function renderStage() {
          const item = getCurrentItem();
          if (!item) return;

          const metaColor = (CAT_META[item.cat] && CAT_META[item.cat].color) || item.accent || '#ff99c8';
          stageBadge.innerText = item.badge;
          stageBadge.style.background = metaColor;
          stageCount.innerText = (activeIdx + 1) + ' / ' + filtered.length;
          captionBar.innerHTML = '<strong>photobinc</strong> ' + (item.caption || '');

          if (item.type === 'gif') {
            btnActDl.innerHTML = '<i class="ri-file-gif-fill"></i> SIMPAN GIF';
            btnActMp4.style.display = 'inline-flex';
            btnActIg.style.display = 'none';
          } else {
            btnActDl.innerHTML = '<i class="ri-download-2-fill"></i> UNDUH HD';
            btnActMp4.style.display = 'none';
            btnActIg.style.display = 'inline-flex';
          }

          const isLiked = likedSet.has(item.id);
          btnLike.classList.toggle('is-liked', isLiked);
          btnLike.innerHTML = isLiked ? '<i class="ri-heart-3-fill"></i>' : '<i class="ri-heart-3-line"></i>';

          const showNav = filtered.length > 1;
          btnPrev.style.display = showNav ? 'inline-flex' : 'none';
          btnNext.style.display = showNav ? 'inline-flex' : 'none';

          mediaSlot.innerHTML = '';
          if (item.type === 'video') {
            const v = document.createElement('video');
            v.src = item.url;
            v.autoplay = true; v.loop = true; v.muted = true; v.playsInline = true; v.preload = 'auto';
            v.setAttribute('autoplay', ''); v.setAttribute('loop', ''); v.setAttribute('muted', '');
            v.setAttribute('playsinline', ''); v.setAttribute('webkit-playsinline', '');
            mediaSlot.appendChild(v);
            v.load();
            v.play().catch(() => {});
          } else {
            const img = document.createElement('img');
            img.src = item.previewUrl || item.url;
            img.alt = item.badge;
            img.onerror = function() {
              if (this.src !== item.url) this.src = item.url;
            };
            mediaSlot.appendChild(img);
          }

          renderThumbStrip();
        }

        function selectCategory(catKey) {
          activeCat = catKey;
          filtered = PB_ITEMS.filter(it => it.cat === catKey);
          activeIdx = 0;
          tabsWrap.querySelectorAll('.neo-tab').forEach(btn => {
            const isMatch = btn.dataset.cat === catKey;
            btn.classList.toggle('is-active', isMatch);
            btn.style.background = isMatch ? (btn.dataset.color || '#ff99c8') : 'rgba(255, 255, 255, 0.06)';
          });
          renderStage();
        }

        function goPrev() {
          if (filtered.length <= 1) return;
          activeIdx = (activeIdx - 1 + filtered.length) % filtered.length;
          renderStage();
        }
        function goNext() {
          if (filtered.length <= 1) return;
          activeIdx = (activeIdx + 1) % filtered.length;
          renderStage();
        }

        btnPrev.addEventListener('click', goPrev);
        btnNext.addEventListener('click', goNext);

        // Dukungan Swipe Kiri/Kanan di Viewport Mobile
        let touchStartX = 0;
        viewport.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        viewport.addEventListener('touchend', (e) => {
          const diff = e.changedTouches[0].screenX - touchStartX;
          if (Math.abs(diff) > 45) {
            if (diff < 0) goNext(); else goPrev();
          }
        }, { passive: true });

        btnLike.addEventListener('click', () => {
          const item = getCurrentItem();
          if (!item) return;
          if (likedSet.has(item.id)) likedSet.delete(item.id); else likedSet.add(item.id);
          renderStage();
        });

        function openLightbox() {
          const item = getCurrentItem();
          if (!item) return;
          lbContent.innerHTML = '';
          if (item.type === 'video') {
            const v = document.createElement('video');
            v.src = item.url; v.controls = true; v.autoplay = true; v.loop = true; v.playsInline = true;
            lbContent.appendChild(v);
            v.play().catch(() => {});
          } else {
            const img = document.createElement('img');
            img.src = item.url;
            lbContent.appendChild(img);
          }
          lightbox.style.display = 'flex';
        }

        btnZoom.addEventListener('click', openLightbox);
        mediaSlot.addEventListener('click', openLightbox);
        btnCloseLb.addEventListener('click', () => { lbContent.innerHTML = ''; lightbox.style.display = 'none'; });
        lightbox.addEventListener('click', e => { if (e.target === lightbox) { lbContent.innerHTML = ''; lightbox.style.display = 'none'; } });

        document.getElementById('btn-copy-link').addEventListener('click', function() {
          const btn = this;
          navigator.clipboard.writeText(window.location.href).then(() => {
            const orig = btn.innerHTML;
            btn.innerHTML = '<i class="ri-check-fill"></i> <span>DISALIN!</span>';
            btn.style.background = 'rgba(74, 222, 128, 0.25)';
            btn.style.borderColor = '#4ade80';
            btn.style.color = '#86efac';
            setTimeout(() => {
              btn.innerHTML = orig;
              btn.style.background = '';
              btn.style.borderColor = '';
              btn.style.color = '';
            }, 2200);
          });
        });

        // FORCE DOWNLOAD FULL RESOLUSI VIA SERVER ENDPOINT (ANTI-PREVIEW & ANTI-CORS)
        function forceDownload(mediaUrl, aliasName, btnEl) {
          const orig = btnEl.innerHTML;
          btnEl.innerHTML = '<i class="ri-loader-4-line spin-anim"></i> MENGUNDUH...';
          btnEl.style.pointerEvents = 'none';

          const dlUrl = '/api/download?url=' + encodeURIComponent(mediaUrl) + '&name=' + encodeURIComponent(aliasName);
          const a = document.createElement('a');
          a.style.display = 'none';
          a.href = dlUrl;
          a.setAttribute('download', aliasName);
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);

          setTimeout(() => {
            btnEl.innerHTML = '<i class="ri-check-double-fill"></i> DIUNDUH!';
            setTimeout(() => {
              btnEl.innerHTML = orig;
              btnEl.style.pointerEvents = 'auto';
            }, 1800);
          }, 800);
        }

        // CONVERT GIF KE MP4 VIA SAME-ORIGIN PROXY (ANTI TAINTED CANVAS)
        async function convertGifToMp4(gifUrl, aliasName, btnEl) {
          const orig = btnEl.innerHTML;
          btnEl.innerHTML = '<i class="ri-loader-4-line spin-anim"></i> MERAKIT...';
          btnEl.style.pointerEvents = 'none';
          try {
            if (typeof SuperGif === 'undefined') throw new Error('Library GIF belum siap');
            const img = document.createElement('img');
            img.crossOrigin = 'Anonymous';
            img.src = '/api/download?url=' + encodeURIComponent(gifUrl) + '&name=' + encodeURIComponent(aliasName);
            const wrap = document.createElement('div');
            wrap.style.display = 'none'; wrap.appendChild(img); document.body.appendChild(wrap);

            const gifObj = new SuperGif({ gif: img, auto_play: false });
            gifObj.load(() => {
              const canvas = gifObj.get_canvas();
              if (canvas.width % 2 !== 0) canvas.width += 1;
              if (canvas.height % 2 !== 0) canvas.height += 1;
              const stream = canvas.captureStream(25);
              let mimeType = 'video/mp4';
              if (!MediaRecorder.isTypeSupported(mimeType)) {
                mimeType = MediaRecorder.isTypeSupported('video/webm;codecs=h264') ? 'video/webm;codecs=h264' : 'video/webm';
              }
              const rec = new MediaRecorder(stream, { mimeType, videoBitsPerSecond: 5000000 });
              const chunks = [];
              rec.ondataavailable = e => { if (e.data.size > 0) chunks.push(e.data); };
              rec.onstop = () => {
                const blobUrl = URL.createObjectURL(new Blob(chunks, { type: mimeType }));
                const a = document.createElement('a');
                a.style.display = 'none'; a.href = blobUrl; a.download = aliasName.replace(/\.gif$/i, '.mp4');
                document.body.appendChild(a); a.click();
                URL.revokeObjectURL(blobUrl); document.body.removeChild(a); document.body.removeChild(wrap);
                btnEl.innerHTML = '<i class="ri-check-double-fill"></i> SELESAI!';
                setTimeout(() => { btnEl.innerHTML = orig; btnEl.style.pointerEvents = 'auto'; }, 2500);
              };
              rec.start(); gifObj.play();
              setTimeout(() => { gifObj.pause(); rec.stop(); }, 3500);
            });
          } catch (e) {
            alert("HP kamu belum mendukung convert video langsung. Gunakan tombol 'Simpan GIF'.");
            btnEl.innerHTML = orig; btnEl.style.pointerEvents = 'auto';
          }
        }

        // SHARE KE IG STORY / SOSMED VIA SAME-ORIGIN PROXY
        async function shareToSosmed(mediaUrl, aliasName, btnEl) {
          const orig = btnEl.innerHTML;
          btnEl.innerHTML = '<i class="ri-loader-4-line spin-anim"></i> SIAPKAN...';
          btnEl.style.pointerEvents = 'none';
          try {
            const proxyUrl = '/api/download?url=' + encodeURIComponent(mediaUrl) + '&name=' + encodeURIComponent(aliasName);
            const res = await fetch(proxyUrl);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const blob = await res.blob();
            const file = new File([blob], aliasName, { type: blob.type });
            if (navigator.canShare && navigator.canShare({ files: [file] })) {
              await navigator.share({ files: [file], title: 'Photobinc Moment', text: 'Seru banget foto di Photobinc!' });
            } else if (navigator.share) {
              await navigator.share({ title: 'Photobinc Moment', text: 'Cek hasil foto seruku di Photobinc!', url: mediaUrl });
            } else {
              alert('Browser tidak mendukung Share langsung. Klik tombol UNDUH HD.');
            }
          } catch (e) {
            if (navigator.share) {
              navigator.share({ title: 'Photobinc Moment', url: mediaUrl }).catch(() => {});
            }
          } finally {
            btnEl.innerHTML = orig; btnEl.style.pointerEvents = 'auto';
          }
        }

        btnActDl.addEventListener('click', function() { const it = getCurrentItem(); if (it) forceDownload(it.url, it.alias_name, this); });
        btnActMp4.addEventListener('click', function() { const it = getCurrentItem(); if (it) convertGifToMp4(it.url, it.alias_name, this); });
        btnActIg.addEventListener('click', function() { const it = getCurrentItem(); if (it) shareToSosmed(it.url, it.alias_name, this); });
        btnActTt.addEventListener('click', function() { const it = getCurrentItem(); if (it) shareToSosmed(it.url, it.alias_name, this); });

        if (PB_ITEMS.length > 0) selectCategory(activeCat);
      })();
    </script>
  <% } %>
</body>
</html>