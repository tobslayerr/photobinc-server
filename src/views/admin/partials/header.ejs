<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> — Photobinc Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { margin: 0; background: #f1f5f9; color: #0f172a; }
    .admin-nav {
      background: #ffffff; border-bottom: 2px solid #e2e8f0; padding: 0 24px;
      position: sticky; top: 0; z-index: 200; display: flex; align-items: center;
      justify-content: space-between; gap: 16px; min-height: 62px; flex-wrap: wrap;
    }
    .nav-brand { font-weight: 900; font-size: 18px; color: #0f172a; text-decoration: none; display: flex; align-items: center; gap: 8px; }
    .nav-links { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .nav-link {
      text-decoration: none; color: #475569; font-weight: 700; font-size: 13.5px;
      padding: 8px 14px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; transition: 0.15s;
    }
    .nav-link:hover { background: #f1f5f9; color: #0f172a; }
    .nav-link.active { background: #0f172a; color: #ffffff; }
    .nav-link.op-link { background: #e0f2fe; color: #0369a1; }
    .nav-link.logout-link { background: #fee2e2; color: #dc2626; }
    .admin-main { max-width: 1320px; margin: 0 auto; padding: 24px 20px 60px; }
    .alert-ok { background: #dcfce7; border: 1px solid #86efac; border-left: 5px solid #16a34a; color: #166534; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-weight: 600; }
    .alert-err { background: #fee2e2; border: 1px solid #fca5a5; border-left: 5px solid #dc2626; color: #991b1b; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-weight: 600; }
    .pb-btn {
      background: #2563eb; color: #fff; border: none; padding: 9px 16px; border-radius: 8px;
      cursor: pointer; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px;
    }
    .pb-btn:hover { opacity: 0.92; }
    .pb-btn-green { background: #10b981; }
    .pb-btn-dark { background: #0f172a; }
    .pb-btn-yellow { background: #eab308; color: #111; }
    .pb-btn-cyan { background: #06b6d4; color: #fff; }
    .pb-btn-red { background: #ef4444; color: #fff; }
    .pb-btn-soft-red { background: #fee2e2; color: #dc2626; }
    .pb-btn-soft-red:hover { background: #ef4444; color: #fff; }
    .pb-btn-outline { background: #fff; color: #1e293b; border: 1px solid #cbd5e1; }
  </style>
</head>
<body>
  <nav class="admin-nav">
    <a href="/admin/sales" class="nav-brand">
      <i class="ri-camera-lens-fill" style="color:#2563eb; font-size:22px;"></i> PHOTOBINC ADMIN
    </a>
    <div class="nav-links">
      <a href="/admin/sales" class="nav-link <%= activeMenu === 'sales' ? 'active' : '' %>"><i class="ri-bar-chart-box-line"></i> Rekap Penjualan</a>
      <a href="/admin/frames" class="nav-link <%= activeMenu === 'frames' ? 'active' : '' %>"><i class="ri-layout-grid-line"></i> Frame & Harga</a>
      <a href="/admin/payment" class="nav-link <%= activeMenu === 'payment' ? 'active' : '' %>"><i class="ri-bank-card-line"></i> Payment</a>
      <a href="/admin/vouchers" class="nav-link <%= activeMenu === 'vouchers' ? 'active' : '' %>"><i class="ri-ticket-2-line"></i> Voucher</a>
      <a href="/operator" class="nav-link op-link" target="_blank"><i class="ri-printer-line"></i> Operator</a>
      <a href="/logout" class="nav-link logout-link"><i class="ri-logout-box-r-line"></i> Keluar</a>
    </div>
  </nav>
  <main class="admin-main">